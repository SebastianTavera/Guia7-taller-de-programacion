# development | production (production disables /docs and requires JWT_SECRET)
APP_ENV=development
DATABASE_URL=sqlite:///./vitreo.db
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Password for the demo users created by `python -m vitreo.seed` (min. 12 characters)
SEED_PASSWORD=
